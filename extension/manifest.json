{
  "manifest_version": 3,
  "name": "Arena Model Unlocker Enhanced",
  "version": "1.0.0",
  "description": "Restore historical model choices in Arena's local selector where possible.",
  "permissions": ["scripting"],
  "host_permissions": [
    "https://arena.ai/*",
    "https://*.arena.ai/*",
    "https://canaryarena.ai/*",
    "https://*.canaryarena.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://arena.ai/*",
        "https://*.arena.ai/*",
        "https://canaryarena.ai/*",
        "https://*.canaryarena.ai/*"
      ],
      "js": ["archive.js", "main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}